<Window x:Class="RapidoWorkingOrders.Dialogs.CatalogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Katalog — Postavke"
        Width="700" Height="560"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/logo.ico"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ══ Tab: Materijali ══ -->
            <TabItem Header="📦  Materijali">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="MatGrid" Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <Label Content="Naziv:" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <TextBox x:Name="MatNameBox" VerticalContentAlignment="Center" Margin="4,0" />
                    </DockPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="➕  Dodaj" Click="AddMat_Click" Padding="10,6" />
                        <Button Content="💾  Spremi" Click="SaveMat_Click"
                                Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="8,0,0,0" />
                        <Button Content="🗑️  Obriši" Click="DeleteMat_Click"
                                Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ Tab: Tehnologije ══ -->
            <TabItem Header="⚙️  Tehnologije">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="TechGrid" Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <Label Content="Naziv:" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <TextBox x:Name="TechNameBox" VerticalContentAlignment="Center" Margin="4,0" />
                    </DockPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="➕  Dodaj" Click="AddTech_Click" Padding="10,6" />
                        <Button Content="💾  Spremi" Click="SaveTech_Click"
                                Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="8,0,0,0" />
                        <Button Content="🗑️  Obriši" Click="DeleteTech_Click"
                                Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ Tab: Završna obrada ══ -->
            <TabItem Header="✅  Završna obrada">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="FinishGrid" Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naziv opcije" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Redoslijed" Binding="{Binding SortOrder}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="Naziv:" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="FinishNameBox" VerticalContentAlignment="Center" />

                        <Label Grid.Column="3" Content="Redoslijed:"
                               VerticalAlignment="Center" FontSize="12" />
                        <TextBox Grid.Column="4" x:Name="FinishSortBox"
                                 VerticalContentAlignment="Center" Text="0" />
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="➕  Dodaj" Click="AddFinish_Click" Padding="10,6" />
                        <Button Content="💾  Spremi" Click="SaveFinish_Click"
                                Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="8,0,0,0" />
                        <Button Content="🗑️  Obriši" Click="DeleteFinish_Click"
                                Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ Tab: Keywordovi ══ -->
            <TabItem Header="🔑  Keywordovi">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="KwGrid" Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Keyword" Binding="{Binding Text}" Width="*" />

                            <DataGridTemplateColumn Header="Materijal" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Material.Name}" Padding="6,2" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Tehnologija" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Technology.Name}" Padding="6,2" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Forma za keyword -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="Keyword:" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="KwTextBox" />

                        <Label Grid.Column="3" Content="Materijal:" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="4" x:Name="KwMatCombo"
                                  ItemsSource="{Binding Materials}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id" />

                        <Label Grid.Column="6" Content="Tehnol.:" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="7" x:Name="KwTechCombo"
                                  ItemsSource="{Binding Technologies}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id" />
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="➕  Dodaj" Click="AddKw_Click" Padding="10,6" />
                        <Button Content="💾  Spremi" Click="SaveKw_Click"
                                Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="8,0,0,0" />
                        <Button Content="🗑️  Obriši" Click="DeleteKw_Click"
                                Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status + Zatvori -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       VerticalAlignment="Center" FontStyle="Italic"
                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Zatvori" Click="Close_Click" Padding="14,6" MinWidth="90" />
        </Grid>
    </Grid>
</Window>
