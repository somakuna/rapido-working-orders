<Window x:Class="RapidoWorkingOrders.Dialogs.ClientsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klijenti"
        Width="700" Height="560"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/logo.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Lista klijenata -->
        <DataGrid x:Name="ClientsGrid" Grid.Row="0"
                  SelectionChanged="ClientsGrid_SelectionChanged"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv"    Binding="{Binding Name}"    Width="*" />
                <DataGridTextColumn Header="OIB"      Binding="{Binding Oib}"     Width="110" />
                <DataGridTextColumn Header="Email"    Binding="{Binding Email}"   Width="160" />
                <DataGridTextColumn Header="Kontakt"  Binding="{Binding Contact}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Forma za uređivanje -->
        <GroupBox Grid.Row="1" Header="Podaci o klijentu" Margin="0,10,0,0">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Naziv:" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                         x:Name="NameBox" Margin="0,3" />

                <Label Grid.Row="1" Grid.Column="0" Content="OIB:" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="OibBox" Margin="0,3" />

                <Label Grid.Row="1" Grid.Column="3" Content="Kontakt:" />
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="ContactBox" Margin="0,3" />

                <Label Grid.Row="2" Grid.Column="0" Content="Email:" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="EmailBox" Margin="0,3" />

                <Label Grid.Row="2" Grid.Column="3" Content="Adresa:" />
                <TextBox Grid.Row="2" Grid.Column="4" x:Name="AddressBox" Margin="0,3" />
            </Grid>
        </GroupBox>

        <!-- Gumbi za CRUD -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="➕  Novi klijent" Click="NewClient_Click" Padding="10,6" />
            <Button Content="💾  Spremi" Click="SaveClient_Click"
                    Style="{StaticResource PrimaryButton}"
                    Padding="10,6" Margin="8,0,0,0" />
            <Button Content="🗑️  Obriši" Click="DeleteClient_Click"
                    Style="{StaticResource PrimaryButton}"
                    Padding="10,6" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Zatvori -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Zatvori" Click="Close_Click" Padding="14,6" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
