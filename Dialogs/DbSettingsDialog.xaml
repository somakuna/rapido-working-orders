<Window x:Class="RapidoWorkingOrders.Dialogs.DbSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Postavke"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/logo.ico"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── MySQL konekcija ── -->
        <TextBlock Grid.Row="0" Text="Konekcija na MySQL bazu podataka"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource BrandBrush}" />

        <!-- ── Poruka o razlogu otvaranja (startup) ── -->
        <Border Grid.Row="2" x:Name="InfoBanner"
                Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1"
                CornerRadius="4" Padding="12,8" Visibility="Collapsed">
            <TextBlock x:Name="InfoText" TextWrapping="Wrap"
                       Foreground="#856404" FontSize="13" />
        </Border>

        <!-- ── Form polja ── -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server (host):"
                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ServerBox"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Port:"
                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PortBox"
                     VerticalContentAlignment="Center" Width="80" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Baza podataka:"
                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="DatabaseBox"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Korisnik:"
                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="UsernameBox"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Lozinka:"
                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <PasswordBox Grid.Row="8" Grid.Column="1" x:Name="PasswordBox" />
        </Grid>

        <!-- ── Test konekcije ── -->
        <Button Grid.Row="6" Content="Testiraj konekciju"
                Click="TestButton_Click" />

        <!-- ── Separator ── -->
        <Separator Grid.Row="7" VerticalAlignment="Center" />

        <!-- ── Korisnici ── -->
        <TextBlock Grid.Row="8" Text="Korisnici"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource BrandBrush}" />

        <Grid Grid.Row="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="140" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" x:Name="UsersGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowBackground="White"
                      AlternatingRowBackground="#FFF8F5"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      BorderBrush="{StaticResource BorderBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Windows korisnik"
                                        Binding="{Binding WindowsName}"
                                        Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Alias (prikazno ime)"
                                        Binding="{Binding ShowName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="2" Content="Spremi aliase" HorizontalAlignment="Right"
                    Width="120" Click="SaveAliases_Click" />

            <DockPanel Grid.Row="4">
                <Button DockPanel.Dock="Right" Content="Ukloni" Width="80"
                        Margin="8,0,0,0" Click="RemoveUser_Click" />
                <Button DockPanel.Dock="Right" Content="Dodaj" Width="80"
                        Margin="8,0,0,0" Click="AddUser_Click" />
                <TextBox x:Name="NewUserBox"
                         VerticalContentAlignment="Center"
                         ToolTip="Windows korisničko ime (npr. RAČUNALO\korisnik ili samo korisnik)" />
            </DockPanel>
        </Grid>

        <!-- ── OK / Odustani ── -->
        <StackPanel Grid.Row="12" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Odustani" Width="100" Click="CancelButton_Click" />
            <Button Content="Spremi" Width="110" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
